PORT=3001
WEB_ORIGIN=http://localhost:3001

# Supabase (server-side values must never be exposed in config.js)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_ENCRYPTION_KEY=

# At least one AI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Social OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/oauth/youtube/callback
# Optional: enables the additional sensitive YouTube Analytics permission.
YOUTUBE_ANALYTICS_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/oauth/facebook/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3001/oauth/tiktok/callback
